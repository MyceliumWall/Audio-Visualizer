#!/usr/bin/env python3
"

Install:
    pip install pygame numpy sounddevice soundfile
    (optional, for m4a/aac and other formats: pip install pydub  + ffmpeg on PATH)

Run:
    python audio_visualizer.py [path/to/audio] [--reduce-motion]

Controls:
    O / "Open audio file" button   choose a file (or drag & drop a file onto the window)
    S / "Stop" button              stop playback
    Up / Down / slider             sensitivity
    Esc                            quit
"""
from __future__ import annotations

import argparse
import colorsys
import math
import random
import subprocess
import sys
import threading

try:
    import numpy as np
    import pygame
except ImportError:
    sys.exit("Missing dependencies. Run: pip install pygame numpy sounddevice soundfile")

# ---------------------------------------------------------------- constants
BG = (0, 0, 0)
INK = (184, 255, 200)
MUTE = (63, 168, 90)
LINE = (11, 74, 28)
PANEL = (2, 10, 4)
ON = (0, 255, 65)

BAR_H = 64
FFT = 2048
BINS = FFT // 2
N = 72                     # number of frequency bands
LEVELS = 12                # brightness steps for pre-rendered glyphs
LIGHTNESS = 0.55
SENS_MIN, SENS_MAX = 0.2, 2.5

KATAKANA = "ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝｦ"
ASCII_GLYPHS = "0123456789:.=*+-<>"
UI_FONTS = "sharetechmono,consolas,menlo,dejavusansmono,couriernew,monospace"
CJK_FONTS = ("msgothic,meiryo,yugothic,notosansmonocjkjp,notosanscjkjp,notosansmonocjk,"
             "hiraginosans,hiraginokakugothicpron,applegothic,takao,ipagothic,ipaexgothic,"
             "unifontmono,unifont")

FILE_DIALOG_CODE = (
    "import tkinter as tk\n"
    "from tkinter import filedialog\n"
    "r = tk.Tk(); r.withdraw(); r.attributes('-topmost', True)\n"
    "p = filedialog.askopenfilename(title='Open audio file', filetypes=["
    "('Audio', '*.wav *.mp3 *.ogg *.flac *.aiff *.aif *.m4a *.aac *.opus'), ('All files', '*.*')])\n"
    "print(p)\n"
)


# ---------------------------------------------------------------- audio I/O
def load_audio(path: str):
    """Decode a file to (float32 array [n, ch<=2], sample_rate)."""
    try:
        import soundfile as sf
        data, sr = sf.read(path, dtype="float32", always_2d=True)
    except Exception:
        try:
            from pydub import AudioSegment
            seg = AudioSegment.from_file(path).set_sample_width(2)
            data = (np.array(seg.get_array_of_samples(), dtype=np.float32)
                    .reshape(-1, seg.channels) / 32768.0)
            sr = seg.frame_rate
        except Exception as exc:
            raise RuntimeError(
                "Could not decode this file (try wav/flac/ogg/mp3, or install pydub + ffmpeg)."
            ) from exc
    if data.shape[1] > 2:
        data = data[:, :2]
    if len(data) == 0:
        raise RuntimeError("The file contains no audio.")
    return np.ascontiguousarray(data), int(sr)


class Player:
    """Looping playback through sounddevice; exposes the audio just played for analysis."""

    def __init__(self):
        self.stream = None
        self.data = None
        self.mono = None
        self.sr = 44100
        self.pos = 0

    @property
    def playing(self) -> bool:
        return self.stream is not None

    def play(self, data, sr):
        import sounddevice as sd  # imported lazily so the UI still starts without PortAudio
        self.stop()
        self.data, self.sr, self.pos = data, sr, 0
        self.mono = data.mean(axis=1).astype(np.float32)
        self.stream = sd.OutputStream(samplerate=sr, channels=data.shape[1],
                                      dtype="float32", callback=self._callback)
        self.stream.start()

    def stop(self):
        if self.stream is not None:
            try:
                self.stream.stop()
                self.stream.close()
            except Exception:
                pass
        self.stream = None
        self.data = self.mono = None

    def _callback(self, outdata, frames, time_info, status):
        data = self.data
        if data is None:
            outdata.fill(0)
            return
        n, pos, filled = len(data), self.pos, 0
        while filled < frames:
            take = min(frames - filled, n - pos)
            outdata[filled:filled + take] = data[pos:pos + take]
            filled += take
            pos = (pos + take) % n
        self.pos = pos

    def snapshot(self, size: int):
        """The most recent `size` mono samples (compensated for output latency)."""
        mono = self.mono
        if mono is None:
            return np.zeros(size, dtype=np.float32)
        n = len(mono)
        pos = self.pos
        try:
            pos = (pos - int(self.stream.latency * self.sr)) % n
        except Exception:
            pass
        if n < size:
            out = np.zeros(size, dtype=np.float32)
            out[-n:] = mono
            return out
        if pos >= size:
            return mono[pos - size:pos]
        return np.concatenate((mono[n - (size - pos):], mono[:pos]))


class Analyser:
    """Mimics the Web Audio AnalyserNode (Blackman window, smoothing 0.78, -100..-30 dB)."""

    def __init__(self):
        self.win = np.blackman(FFT).astype(np.float32)
        self.smooth = np.zeros(BINS, dtype=np.float32)

    def reset(self):
        self.smooth[:] = 0

    def spectrum(self, samples):
        mag = np.abs(np.fft.rfft(samples * self.win))[:BINS] / FFT
        self.smooth = 0.78 * self.smooth + 0.22 * mag
        db = 20 * np.log10(np.maximum(self.smooth, 1e-10))
        return np.clip((db + 100) / 70 * 255, 0, 255)


# ---------------------------------------------------------------- glyph rain
class GlyphSet:
    """Pre-rendered glyph surfaces at several brightness levels (fast to blit)."""

    def __init__(self, fs: int):
        self.fs = fs
        font = self._pick_font(fs)
        chars = KATAKANA + ASCII_GLYPHS
        if not self._supports(font, KATAKANA):
            chars = ASCII_GLYPHS * 3
        self.count = len(chars)
        self.body = []
        self.head = []
        for ch in chars:
            self.body.append([None] + [
                font.render(ch, True, (0, int(255 * lv / (LEVELS - 1)), int(65 * lv / (LEVELS - 1))))
                for lv in range(1, LEVELS)])
            self.head.append([None] + [
                font.render(ch, True, tuple(int(c * lv / (LEVELS - 1)) for c in (190, 255, 200)))
                for lv in range(1, LEVELS)])

    @staticmethod
    def _supports(font, text):
        try:
            return all(m is not None for m in font.metrics(text[:6]))
        except Exception:
            return False

    @staticmethod
    def _pick_font(fs):
        font = pygame.font.SysFont(CJK_FONTS, fs)
        if GlyphSet._supports(font, KATAKANA):
            return font
        return pygame.font.SysFont(UI_FONTS, fs)


class Rain:
    def __init__(self, reduce_motion: bool):
        self.reduce = reduce_motion
        self.sets: dict[int, GlyphSet] = {}
        self.cols: list[dict] = []
        self.fs = 18
        self.rows = 0

    def resize(self, w: int, h: int):
        self.fs = 14 if w < 600 else 18
        if self.fs not in self.sets:
            self.sets[self.fs] = GlyphSet(self.fs)
        gs = self.sets[self.fs]
        self.rows = math.ceil(h / self.fs)
        self.cols = [{"y": random.random() * self.rows,
                      "s": 0.12 + random.random() * 0.3,
                      "len": random.randint(8, 23),
                      "c": [random.randrange(gs.count) for _ in range(self.rows + 30)]}
                     for _ in range(math.ceil(w / self.fs))]

    def draw(self, surf, bass: float):
        if not self.cols:
            return
        gs, fs, rows = self.sets[self.fs], self.fs, self.rows
        boost = 1.0 if self.reduce else 1 + bass * 3
        head_lv = int(min(1.0, 0.5 + bass) * (LEVELS - 1))
        blit = surf.blit
        for i, c in enumerate(self.cols):
            if not self.reduce:
                c["y"] += c["s"] * boost
            if c["y"] - c["len"] > rows:
                c["y"] = -random.random() * 8
                c["s"] = 0.12 + random.random() * 0.3
                c["len"] = random.randint(8, 23)
            if random.random() < 0.05:
                c["c"][random.randrange(len(c["c"]))] = random.randrange(gs.count)
            head = math.floor(c["y"])
            ln, chars = c["len"], c["c"]
            for k in range(ln):
                r = head - k
                if r < 0 or r > rows:
                    continue
                if k == 0:
                    lv, table = head_lv, gs.head
                else:
                    a = (1 - k / ln) ** 1.6 * (0.28 + bass * 0.5)
                    lv, table = int(min(1.0, a) * (LEVELS - 1)), gs.body
                if lv <= 0:
                    continue
                g = table[chars[r]][lv]
                blit(g, (i * fs + (fs - g.get_width()) // 2, r * fs))


# ---------------------------------------------------------------- app
def hue_color(t: float, alpha: int):
    h = (128 + 22 * t) / 360.0
    r, g, b = colorsys.hls_to_rgb(h, LIGHTNESS, 0.85)
    return int(r * 255), int(g * 255), int(b * 255), alpha


class App:
    def __init__(self, reduce_motion=False):
        pygame.init()
        pygame.display.set_caption("Audio visualizer")
        self.screen = pygame.display.set_mode((1100, 700), pygame.RESIZABLE)
        self.clock = pygame.time.Clock()
        self.ui_font = pygame.font.SysFont(UI_FONTS, 17, bold=True)
        self.small_font = pygame.font.SysFont(UI_FONTS, 15)
        self.hint_font = pygame.font.SysFont(UI_FONTS, 28)
        self.reduce = reduce_motion

        self.rain = Rain(reduce_motion)
        self.player = Player()
        self.analyser = Analyser()
        self.sm = np.zeros(N, dtype=np.float32)
        edges = [int(2 * math.pow(350, i / N)) for i in range(N + 1)]
        self.band_edges = [(edges[i], max(edges[i] + 1, edges[i + 1])) for i in range(N)]

        self.sens = 0.6
        self.active = False
        self.status = ""
        self.hint_alpha = 1.0
        self.running = True
        self.size = (0, 0)
        self.overlay = None
        self.rects: dict[str, pygame.Rect] = {}
        self.slider_rect = pygame.Rect(0, 0, 120, 20)
        self.dragging = False
        self.dialog = None
        self._result = None
        self.loading = False

    # ----- sources
    def stop(self):
        self.player.stop()
        self.analyser.reset()
        self.active = False
        self.status = ""

    def open_dialog(self):
        if self.dialog is not None or self.loading:
            return
        try:
            self.dialog = subprocess.Popen([sys.executable, "-c", FILE_DIALOG_CODE],
                                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        except OSError:
            self.status = "Could not open a file dialog. Drag a file onto the window instead."

    def load_file(self, path: str):
        if self.loading:
            return
        self.loading = True
        self.status = "Loading…"

        def work():
            try:
                data, sr = load_audio(path)
                self._result = ("ok", data, sr, path.replace("\\", "/").split("/")[-1])
            except Exception as exc:
                self._result = ("err", str(exc))

        threading.Thread(target=work, daemon=True).start()

    def _poll_background(self):
        if self.dialog is not None and self.dialog.poll() is not None:
            out = (self.dialog.stdout.read() or "").strip() if self.dialog.stdout else ""
            code = self.dialog.returncode
            self.dialog = None
            if out:
                self.load_file(out)
            elif code != 0:
                self.status = "File dialog unavailable (tkinter missing?). Drag a file onto the window."
        if self._result is not None:
            res, self._result = self._result, None
            self.loading = False
            if res[0] == "ok":
                _, data, sr, name = res
                self.stop()
                try:
                    self.player.play(data, sr)
                except Exception as exc:
                    self.status = f"Audio output failed: {exc}"
                else:
                    self.active = True
                    self.status = "Playing " + name
            else:
                self.status = res[1]

    # ----- events
    def handle(self, e):
        if e.type == pygame.QUIT:
            self.running = False
        elif e.type == pygame.KEYDOWN:
            if e.key == pygame.K_ESCAPE:
                self.running = False
            elif e.key == pygame.K_o:
                self.open_dialog()
            elif e.key == pygame.K_s:
                self.stop()
            elif e.key == pygame.K_UP:
                self.sens = min(SENS_MAX, self.sens + 0.1)
            elif e.key == pygame.K_DOWN:
                self.sens = max(SENS_MIN, self.sens - 0.1)
        elif e.type == pygame.DROPFILE:
            self.load_file(e.file)
        elif e.type == pygame.MOUSEBUTTONDOWN and e.button == 1:
            if self.rects.get("open", pygame.Rect(0, 0, 0, 0)).collidepoint(e.pos):
                self.open_dialog()
            elif self.rects.get("stop", pygame.Rect(0, 0, 0, 0)).collidepoint(e.pos):
                self.stop()
            elif self.slider_rect.inflate(16, 16).collidepoint(e.pos):
                self.dragging = True
                self._slide(e.pos[0])
        elif e.type == pygame.MOUSEMOTION and self.dragging:
            self._slide(e.pos[0])
        elif e.type == pygame.MOUSEBUTTONUP and e.button == 1:
            self.dragging = False

    def _slide(self, x):
        t = (x - self.slider_rect.left) / max(1, self.slider_rect.width)
        self.sens = SENS_MIN + max(0.0, min(1.0, t)) * (SENS_MAX - SENS_MIN)

    # ----- analysis
    def update_bands(self, freq, now):
        for i, (a, b) in enumerate(self.band_edges):
            if freq is not None:
                v = float(freq[a:b].mean()) / 255
                v = min(1.0, v ** 1.4 * self.sens * (1 + i / N * 0.9))
            else:
                v = 0.04 + 0.03 * math.sin(now / 700 + i * 0.35)
            self.sm[i] = max(v, self.sm[i] * 0.9)

    # ----- drawing
    def draw_wave(self, wave, now, w, h):
        m = min(w, h)
        width = int(round(max(1.3, m * 0.0039)))
        pts = 300
        step = FFT // pts
        idx = np.arange(pts + 1)
        xs = idx / pts * w
        for li, (_, dy) in enumerate([(0, 0), (0.5, 6), (1, 12)]):
            c = [0, 0.5, 1][li]
            if wave is not None:
                v = np.clip(wave[idx * step], -1, 1) * self.sens * 1.4
            else:
                v = np.sin(now / 600 + idx * 0.06 + li) * 0.03
            ys = h / 2 + v * h * 0.38
            if li:
                ys = ys + dy * np.sin(idx * 0.05 + now / 900)
            pts_list = list(zip(xs.tolist(), ys.tolist()))
            self.overlay.fill((0, 0, 0, 0))
            pygame.draw.lines(self.overlay, hue_color(c, int(255 * (1 - li * 0.28))), False, pts_list, width)
            self.screen.blit(self.overlay, (0, 0))

    def button(self, key, label, x, cy, mouse):
        surf = self.ui_font.render(label, True, INK)
        rect = pygame.Rect(x, 0, surf.get_width() + 28, surf.get_height() + 16)
        rect.centery = cy
        hover = rect.collidepoint(mouse)
        pygame.draw.rect(self.screen, MUTE if hover else LINE, rect, 1, border_radius=rect.height // 2)
        self.screen.blit(surf, surf.get_rect(center=rect.center))
        self.rects[key] = rect
        return rect.right

    def draw_bar(self, w, h):
        top = h - BAR_H
        cy = top + BAR_H // 2
        pygame.draw.rect(self.screen, PANEL, (0, top, w, BAR_H))
        pygame.draw.line(self.screen, LINE, (0, top), (w, top))
        mouse = pygame.mouse.get_pos()
        x = 16
        x = self.button("open", "Open audio file", x, cy, mouse) + 8
        x = self.button("stop", "Stop", x, cy, mouse) + 18
        pygame.draw.line(self.screen, LINE, (x, top + 14), (x, h - 14))
        x += 18
        lab = self.small_font.render("Sensitivity", True, MUTE)
        self.screen.blit(lab, lab.get_rect(midleft=(x, cy)))
        x += lab.get_width() + 8
        self.slider_rect = pygame.Rect(x, cy - 10, 120, 20)
        pygame.draw.line(self.screen, LINE, (x, cy), (x + 120, cy), 4)
        t = (self.sens - SENS_MIN) / (SENS_MAX - SENS_MIN)
        kx = int(x + t * 120)
        pygame.draw.line(self.screen, ON, (x, cy), (kx, cy), 4)
        pygame.draw.circle(self.screen, ON, (kx, cy), 8)
        x += 120 + 24
        avail = w - 16 - x
        if self.status and avail > 40:
            text = self.status
            while text and self.small_font.size(text)[0] > avail:
                text = text[:-2] + "…" if text.endswith("…") is False else text[:-2] + "…"
                if len(text) <= 1:
                    break
            s = self.small_font.render(text, True, MUTE)
            self.screen.blit(s, s.get_rect(midright=(w - 16, cy)))

    # ----- main loop
    def step(self):
        for e in pygame.event.get():
            self.handle(e)
        self._poll_background()

        w, total_h = self.screen.get_size()
        h = max(1, total_h - BAR_H)
        if (w, h) != self.size:
            self.size = (w, h)
            self.overlay = pygame.Surface((w, h), pygame.SRCALPHA)
            self.rain.resize(w, h)

        now = pygame.time.get_ticks()
        wave = freq = None
        if self.active and self.player.playing:
            wave = self.player.snapshot(FFT)
            freq = self.analyser.spectrum(wave)
        self.update_bands(freq, now)
        bass = float(self.sm[:6].mean())

        self.screen.fill(BG)
        self.screen.set_clip(pygame.Rect(0, 0, w, h))
        self.rain.draw(self.screen, bass)
        self.draw_wave(wave, now, w, h)

        target = 0.0 if self.active else 1.0
        self.hint_alpha += (target - self.hint_alpha) * 0.12
        if self.hint_alpha > 0.02:
            s = self.hint_font.render("Pick a sound source below to see it move.", True, MUTE)
            s.set_alpha(int(255 * self.hint_alpha))
            self.screen.blit(s, s.get_rect(center=(w // 2, h // 2)))
        self.screen.set_clip(None)

        self.draw_bar(w, total_h)
        pygame.display.flip()
        self.clock.tick(60)

    def run(self):
        while self.running:
            self.step()
        self.stop()
        pygame.quit()


def main():
    ap = argparse.ArgumentParser(description="Matrix-style audio visualizer")
    ap.add_argument("file", nargs="?", help="audio file to play on start")
    ap.add_argument("--reduce-motion", action="store_true", help="keep the rain static")
    args = ap.parse_args()
    app = App(reduce_motion=args.reduce_motion)
    if args.file:
        app.load_file(args.file)
    app.run()


if __name__ == "__main__":
    main()
